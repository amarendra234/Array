class Solution {
public:
    vector<int> vowelStrings(vector<string>& words, vector<vector<int>>& queries) {
        int n=queries.size();
        vector<int>ans(n,0);
        unordered_map<char,int>umap;
        string str="aeiou";
        for(auto nbr:str){
            umap[nbr]++;
        }
         vector<int>prefixSum(words.size(),0);
        for(int i=0;i<words.size();i++){
            string s=words[i];
            char firstCharacter=s[0];
            char lastCharacter=s[s.size()-1];
            if(umap.find(firstCharacter)!=umap.end() and umap.find(lastCharacter)!=umap.end()){
                  prefixSum[i]=i==0?1:prefixSum[i-1]+1;
            }else{
                prefixSum[i]=i==0?0:prefixSum[i-1];
            }
        }
        for(int i=0;i<n;i++){
            int start=queries[i][0];
            int end=queries[i][1];
            if(start==0){
                ans[i]=prefixSum[end];
            }else{
                ans[i]=prefixSum[end]-prefixSum[start-1];
            }
        }

        return ans;
    }
};
