class Solution {
public:
    int waysToSplitArray(vector<int>& nums) {
        int count=0;
        long long int sum=0;
        for(int i=0;i<nums.size();i++){
            sum+=nums[i];
        }
        long long int curr_sum=0;
        for(int i=0;i<nums.size()-1;i++){
            curr_sum+=nums[i];
            sum-=nums[i];
            if(curr_sum>=sum){
                count++;
            }
        }

        return count;
    }
};
